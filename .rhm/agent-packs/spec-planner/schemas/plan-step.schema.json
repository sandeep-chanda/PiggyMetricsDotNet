{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plan-step.schema.json",
  "title": "PlanStep",
  "type": "object",
  "required": [
    "id", "title", "depends_on", "files", "change", "do_not",
    "tests", "acceptance", "rollback", "why", "expected_result",
    "exact_files"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^STEP-" },
    "title": { "type": "string", "minLength": 8 },
    "depends_on": { "type": "array", "items": { "type": "string" } },
    "requirement_refs": { "type": "array", "items": { "type": "string" } },
    "decision_refs": { "type": "array", "items": { "type": "string" } },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "files": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "exact_files": { "type": "array", "items": { "type": "string" } },
    "existing_implementation": { "type": "string" },
    "before_snippet": { "type": "string" },
    "creates_file": { "type": "boolean" },
    "line_anchor": { "type": "string" },
    "change": { "type": "string", "minLength": 40 },
    "do_not": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "compatibility": { "type": "string" },
    "error_handling": { "type": "string" },
    "tests": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "acceptance": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "rollback": { "type": "string" },
    "why": { "type": "string", "minLength": 20 },
    "expected_result": { "type": "string", "minLength": 20 },
    "exact_commands": { "type": "array", "items": { "type": "string" } },
    "exact_copy": {},
    "exact_aria": {},
    "exact_snippet": { "type": "string" },
    "exact_markup": { "type": "string" },
    "exact_companion": { "type": "string" },
    "exact_css": { "type": "string" },
    "companion_required": { "type": "boolean" },
    "css_required": { "type": "boolean" },
    "exact_branch": { "type": "string" },
    "edge_cases": { "type": "array", "items": { "type": "string" } },
    "invariants": { "type": "array", "items": { "type": "string" } },
    "machine_verify": { "type": "array", "items": { "type": "string" } },
    "human_verify": { "type": "array", "items": { "type": "string" } },
    "input_contract": { "type": "string" },
    "output_contract": { "type": "string" }
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "implementation-plan.schema.json",
  "title": "ImplementationPlan",
  "type": "object",
  "required": ["task_id", "steps"],
  "properties": {
    "task_id": { "type": "string" },
    "summary": { "type": "string" },
    "steps": {
      "type": "array",
      "items": { "$ref": "plan-step.schema.json" },
      "minItems": 1
    }
  },
  "additionalProperties": true
}

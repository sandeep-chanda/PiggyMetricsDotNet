{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "decision-entropy.schema.json",
  "title": "DecisionEntropy",
  "type": "object",
  "required": ["items", "critical_unresolved_count"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "question", "severity", "action"],
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "ARCHITECTURAL", "API", "DATA", "ERROR_HANDLING", "SECURITY",
              "PERFORMANCE", "TESTING", "DEPLOYMENT", "MIGRATION", "OBSERVABILITY"
            ]
          },
          "question": { "type": "string" },
          "severity": { "type": "string", "enum": ["critical", "important", "minor"] },
          "action": { "type": "string", "enum": ["BLOCK", "RESEARCH", "ALLOW"] }
        }
      }
    },
    "critical_unresolved_count": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": true
}

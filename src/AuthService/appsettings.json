{
  "spring": {
    "application": {
      "name": "auth-service"
    },
    "cloud": {
      "config": {
        "uri": "http://config:8888",
        "fail-fast": true,
        "username": "user",
        "password": "${CONFIG_SERVICE_PASSWORD}"
      }
    },
    "data": {
      "mongodb": {
        "host": "auth-mongodb",
        "username": "user",
        "password": "${MONGODB_PASSWORD}",
        "database": "piggymetrics",
        "port": 27017
      }
    }
  },
  "server": {
    "servlet": {
      "context-path": "/uaa"
    },
    "port": 5000
  }
}
